generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SAAS AUTHENTICATION & USERS
// ==========================================

enum Role {
  USER
  ADMIN
}

model User {
  id             String          @id // Matches Firebase UID
  email          String          @unique
  firstName      String?
  lastName       String?
  role           Role            @default(USER)

  // Relationships
  accounts       Account[]
  transactions   Transaction[]
  loans          Loan[]
  recurringBills RecurringBill[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ==========================================
// 2. FINANCIAL LEDGERS (ACCOUNTS)
// ==========================================

enum AccountType {
  BANK          // Savings / Current Bank Accounts
  CASH          // Liquid Cash / Physical Wallet
  CREDIT_CARD   // Credit Cards
  INVESTMENT    // Stocks / Mutual Funds / Crypto
  SAVINGS       // High-yield / FD Accounts
}

model Account {
  id             String          @id @default(uuid())
  name           String          // e.g., "HDFC Bank", "Petty Cash", "Main Credit Card"
  type           AccountType     @default(BANK)
  
  // Account Details (Optional for CASH)
  accountNumber  String?        
  ifscCode       String?        
  branch         String?        
  
  currentBalance Float           @default(0)
  currency       String          @default("INR")
  status         String          @default("ACTIVE")
  isLiquid       Boolean         @default(false) // True for physical cash and instant withdrawal checking accounts
  
  // SaaS Tenant Link
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  // Relationships
  transactions     Transaction[] @relation("SourceAccount")
  transferReceipts Transaction[] @relation("DestinationAccount")
  recurringBills   RecurringBill[]
}

// ==========================================
// 3. TRANSACTIONS & MULTI-FUNDING ENGINE
// ==========================================

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER // Internal transfer between user's own accounts
}

enum PaymentType {
  STANDARD
  PRINCIPAL
  INTEREST
  FEE
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  paymentType     PaymentType     @default(STANDARD)
  amount          Float
  category        String
  note            String?
  date            DateTime        @default(now())

  // Primary Account (Source account for EXPENSE/TRANSFER, Target account for INCOME)
  accountId       String
  account         Account         @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)

  // Target Account (ONLY used when type === TRANSFER)
  toAccountId     String?
  toAccount       Account?        @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  // Relational Auditing (Links to Bills and Loans)
  loanId          String?
  loan            Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)

  recurringBillId String?
  recurringBill   RecurringBill?  @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)

  // SaaS Tenant Link
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ==========================================
// 4. LIABILITIES & RECEIVABLES ENGINE (LOANS)
// ==========================================

enum LoanDirection {
  BORROWED  // You took money (Liability)
  LENT      // You gave money (Asset)
}

model Loan {
  id             String          @id @default(uuid())
  counterparty   String          // Bank name, friend's name, or business
  
  direction      LoanDirection   @default(BORROWED)
  type           String          // 'PERSONAL', 'HOME', 'BUSINESS', 'GOLD'
  
  principal      Float          
  monthlyRate    Float?          @default(0)

  interestType   String          @default("SIMPLE") 
  startDate      DateTime        @default(now())
  status         String          @default("ACTIVE") // 'ACTIVE' or 'CLEARED'
  clearedDate    DateTime?
  dueDate        DateTime?       // Target Payoff Date
  
  // SaaS Tenant Link
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment History
  transactions   Transaction[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ==========================================
// 5. RECURRING BILLS ENGINE
// ==========================================

enum RecurrenceInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model RecurringBill {
  id             String             @id @default(uuid())
  name           String             // e.g., "Apartment Rent", "AWS Hosting"
  amount         Float
  category       String             
  
  interval       RecurrenceInterval @default(MONTHLY)
  customDays     Int?               
  
  nextDueDate    DateTime           
  lastPaidDate   DateTime?          
  status         String             @default("ACTIVE") 

  accountId      String
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment History
  transactions   Transaction[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}